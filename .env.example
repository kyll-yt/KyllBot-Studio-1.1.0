PORT=12000
PUBLIC_URL=http://localhost:12000
AUTH_SECRET=change-me-in-production

# Emails transactionnels (Resend) - sans clé, le code est affiché en mode démo
RESEND_API_KEY=
MAIL_FROM=KyllBot Studio <no-reply@kyllbot.studio>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Forcer le cookie de session en Secure (HTTPS)
COOKIE_SECURE=0
