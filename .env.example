# Port public du gateway et port interne de l'application
# `npm start` lance le superviseur : gateway + application sont relancés automatiquement.
GATEWAY_PORT=12000
APP_PORT=12001
# 0 = le gateway affiche la page de redémarrage sans lancer l'application
APP_AUTOSTART=1
PUBLIC_URL=http://localhost:12000
AUTH_SECRET=change-me-in-production

# Compte propriétaire (accès maximal et code de mise à jour)
# Si vide, le premier compte réel (hors démo) est utilisé.
OWNER_EMAIL=

# Emails transactionnels - Resend ou SMTP
# Sans fournisseur configuré, le code est affiché en mode démo.
RESEND_API_KEY=
MAIL_FROM=KyllBot Studio <no-reply@kyllbot.studio>

# Alternative SMTP (Gmail, Brevo, OVH, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Forcer le cookie de session en Secure (HTTPS)
COOKIE_SECURE=0

# Chiffrement des tokens Discord (AES-256-GCM)
# Clé de 32 octets en hex (64 caractères) ou base64. Si vide, une clé locale
# est générée dans data/.token-key (dossier ignoré par git).
TOKEN_ENCRYPTION_KEY=

# Connexion automatique des bots Discord au démarrage (1 = oui, 0 = non)
DISCORD_AUTOSTART=1

# Demander les intents privilégiés (membres + contenu des messages).
# 0 = mode sûr uniquement (commandes slash, sans accueil ni lecture du contenu).
DISCORD_PRIVILEGED_INTENTS=1

# Fuseau horaire utilisé pour la récompense quotidienne et les rappels
APP_TIMEZONE=Europe/Paris

# Stockage persistant Supabase (optionnel en local, recommandé sur Render)
# Exécuter supabase/schema.sql dans le SQL Editor, puis renseigner ces variables.
# Les alias supabaseUrl / supabaseServiseRolKey / supabaseServiceRoleKey sont aussi acceptés.
# La clé doit être la clé service_role (pas anon/publishable), sinon Supabase renvoie
# un état vide et refuse les écritures.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=kyll_state
SUPABASE_STATE_ID=default

# Sur Render, garde une valeur stable pour TOKEN_ENCRYPTION_KEY (ou AUTH_SECRET).
# Sinon les tokens Discord chiffrés ne seront plus déchiffrables après un redéploiement
# car le dossier data/ est éphémère.
