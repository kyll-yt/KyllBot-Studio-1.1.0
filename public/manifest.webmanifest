{
  "id": "/app",
  "name": "KyllBot Studio",
  "short_name": "KyllBot",
  "description": "Créez des bots Discord et des formations interactives, sans coder.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07060d",
  "theme_color": "#07060d",
  "categories": ["productivity", "education", "developer"],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mes bots",
      "short_name": "Bots",
      "url": "/app#/bots",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Formations",
      "short_name": "Formations",
      "url": "/app#/courses",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Avis & idées",
      "short_name": "Avis",
      "url": "/app#/feedback",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
